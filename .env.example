# PostgreSQL（本地示例，使用前复制为 .env 并替换密码）
DATABASE_URL=postgresql+psycopg://scf_admin:YOUR_PASSWORD@127.0.0.1:55432/scf

# 模型与问答模式
QA_MODE=demo
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_HOME=E:/scf-env/hf-cache
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
CHUNK_SIZE=350
CHUNK_OVERLAP=50
INDEX_TIMEOUT_SECONDS=300
LLM_PROVIDER=bailian
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-flash-2025-07-28

# 问答与检索（相似度门槛是 M4 的临时值，M5 用验证集调参后确定）
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.40
QA_RATE_LIMIT_PER_MINUTE=10
LLM_TIMEOUT_SECONDS=45
# 云端模式示例：QA_MODE=cloud，LLM_PROVIDER 为 bailian 或 deepseek，LLM_BASE_URL 不含 /chat/completions。
# LLM_API_KEY 只写在本机 .env，不要提交。
